# SQLite file lives at <project>/db/custom.db. The relative form resolves
# against prisma/ and works on every platform (equivalent to the previous
# absolute /home/z/my-project/db/custom.db on the original host).
DATABASE_URL=file:../db/custom.db
JWT_SECRET=fisherman-module-super-secret-change-me-in-production-9f8e7d6c5b4a
JWT_EXPIRES_HOURS=168
SESSION_COOKIE_NAME=fisherman_session
# Weather/marine data uses Open-Meteo (free, no key required).
# Override endpoints if you run a private mirror.
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1
# Reverse geocoding (Open-Meteo geocoding API, free)
OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1/search
# Optional market price API (leave empty -> shows "Market price unavailable")
FISH_MARKET_API_URL=
FISH_MARKET_API_KEY=
# ── AI Fish Analysis (Z.AI vision) — SERVER-SIDE ONLY ──────────────────────
# Preferred over .z-ai-config. Paste your real key from
# https://z.ai/manage-apikey/apikey-list and RESTART the server.
# Leave empty to fall back to the .z-ai-config file.
Z_AI_API_KEY=
# Optional overrides
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4
# Z.AI vision model used for fish analysis.
# glm-4.6v-flash = free tier (works on a free account, occasionally busy).
# glm-4.6v       = higher quality paid model (requires account balance).
Z_AI_VISION_MODEL=glm-4.6v-flash
